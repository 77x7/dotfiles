#!/usr/bin/env bash

set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: dotfiles <command> [options]

Commands:
  list                                  List portable modules
  capture [modules]                     Refresh portable payload
  apply [modules] [--dry-run]           Restore portable modules
  apply-video-wallpapers [--dry-run]    Set landscape/portrait Plasma videos
  bootstrap [--groups LIST] [--flatpaks] [--dry-run] [--yes]
                                        Install mapped packages
  packages                              Show package intent for this distro
  projects                              Show canonical source repositories
  check                                 Validate manifests and scan for leaks
EOF
}

list_modules() {
  awk -F '\t' 'NR > 1 && $1 !~ /^#/ && $5 == "portable" {print $1}' "$MANIFEST" | sort -u
}

capture() {
  local selected=all module source destination mode scope source_path destination_path
  while (( $# )); do
    selected="$1"
    shift
  done
  require rsync
  while IFS=$'\t' read -r module source destination mode scope; do
    [[ -n "$module" && "$module" != module && "$module" != \#* ]] || continue
    [[ "$scope" == portable ]] || continue
    module_selected "$module" "$selected" || continue
    destination_path="$ROOT/payload/home/$destination"
    source_path="$HOME/$source"
    if [[ "$module" == video-wallpapers && -e "$HOME/$destination" ]]; then
      source_path="$HOME/$destination"
    fi
    if [[ ! -e "$source_path" && ! -L "$source_path" ]]; then
      printf 'missing: ~/%s\n' "$source"
      continue
    fi
    mkdir -p "$(dirname "$destination_path")"
    if [[ "$mode" == dir ]]; then
      mkdir -p "$destination_path"
      rsync -a --delete --exclude='.git/' --exclude='node_modules/' --exclude='build/' --exclude='target/' --exclude='__pycache__/' -- "$source_path/" "$destination_path/"
    else
      rsync -a -- "$source_path" "$destination_path"
      if [[ "$mode" == template && -f "$destination_path" ]]; then
        sed -i "s|$HOME|__HOME__|g" "$destination_path"
      fi
    fi
    if [[ "$destination" == .zshrc ]]; then
      sed -i \
        -e '/source ~\/powerlevel10k\/powerlevel10k.zsh-theme/d' \
        -e '/^[[:space:]]*export ANTHROPIC_/d' \
        -e '/^[[:space:]]*export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY/d' \
        "$destination_path"
      if ! grep -Fq '.config/shell/local.zsh' "$destination_path"; then
        printf '\n# Machine-local endpoints and credentials belong outside the repository.\n[[ ! -r "$HOME/.config/shell/local.zsh" ]] || source "$HOME/.config/shell/local.zsh"\n' >> "$destination_path"
      fi
    fi
    printf 'captured: %s\n' "$module:$source"
  done < "$MANIFEST"
}

apply_portable() {
  local selected=all dry_run=0 module source destination mode scope source_path target backup_root
  while (( $# )); do
    case "$1" in
      --dry-run) dry_run=1 ;;
      *) selected="$1" ;;
    esac
    shift
  done
  require rsync
  backup_root="$STATE_ROOT/backups/$(date +%Y%m%d-%H%M%S)"
  while IFS=$'\t' read -r module source destination mode scope; do
    [[ "$scope" == portable ]] || continue
    module_selected "$module" "$selected" || continue
    source_path="$ROOT/payload/home/$destination"
    [[ -e "$source_path" ]] || { printf 'not captured: %s\n' "$destination"; continue; }
    if [[ "$module" == video-wallpapers ]]; then target="$HOME/$destination"; else target="$HOME/$source"; fi
    if (( dry_run )); then
      printf 'would apply: %s -> %s\n' "$source_path" "$target"
      continue
    fi
    backup_path "$target" "$backup_root"
    mkdir -p "$(dirname "$target")"
    if [[ "$mode" == dir ]]; then
      mkdir -p "$target"
      rsync -a -- "$source_path/" "$target/"
    elif [[ "$mode" == template ]]; then
      render_file "$source_path" "$target"
    else
      cp -a -- "$source_path" "$target"
    fi
  done < "$MANIFEST"
  (( dry_run )) || info "Backup: $backup_root"
}

detect_family() {
  local family=fedora
  if [[ -n "${DOTFILES_OS_FAMILY:-}" ]]; then
    [[ "$DOTFILES_OS_FAMILY" =~ ^(fedora|arch|debian|opensuse|nix)$ ]] || die "Invalid DOTFILES_OS_FAMILY: $DOTFILES_OS_FAMILY"
    printf '%s\n' "$DOTFILES_OS_FAMILY"
    return 0
  fi
  [[ -r /etc/os-release ]] && source /etc/os-release
  case " ${ID:-} ${ID_LIKE:-} " in
    *nixos*) family=nix ;;
    *suse*) family=opensuse ;;
    *arch*) family=arch ;;
    *debian*|*ubuntu*) family=debian ;;
  esac
  printf '%s\n' "$family"
}

show_packages() {
  local family
  family="$(detect_family)"
  require jq
  jq -r --arg family "$family" '"Detected package family: \($family)\n", (.groups | to_entries[] | "[\(.key)]\n\(.value[$family] // [] | join(" "))\n")' "$ROOT/manifests/packages.json"
}

bootstrap() {
  local family groups="core,desktop,appearance" dry_run=0 yes=0 install_flatpaks=0
  local -a packages=() command=() root_command=()
  while (( $# )); do
    case "$1" in
      --groups) (( $# >= 2 )) || die '--groups requires a comma-separated value'; groups="$2"; shift ;;
      --flatpaks) install_flatpaks=1 ;;
      --dry-run) dry_run=1 ;;
      --yes) yes=1 ;;
      *) die "Unknown bootstrap option: $1" ;;
    esac
    shift
  done
  family="$(detect_family)"
  require jq
  if [[ "$family" == nix ]]; then
    info 'NixOS support is planned but not implemented yet.'
    info 'No imperative package installation was attempted; NixOS will use declarative modules.'
    return 0
  fi
  mapfile -t packages < <(jq -r --arg family "$family" --arg groups "$groups" '
    ($groups | split(",")) as $selected
    | .groups | to_entries[] | select(.key as $key | $selected | index($key))
    | .value[$family][]?' "$ROOT/manifests/packages.json")
  (( ${#packages[@]} > 0 )) || die "No packages mapped for $family groups: $groups"
  if (( EUID != 0 )); then require sudo; root_command=(sudo); fi
  case "$family" in
    fedora) command=(dnf install); (( yes )) && command+=(-y) ;;
    arch) command=(pacman -S --needed); (( yes )) && command+=(--noconfirm) ;;
    debian)
      if (( dry_run )); then printf '+ '; printf '%q ' "${root_command[@]}" apt-get update; printf '\n';
      else "${root_command[@]}" apt-get update; fi
      command=(apt-get install); (( yes )) && command+=(-y) ;;
    opensuse) command=(zypper install); (( yes )) && command+=(--non-interactive) ;;
    *) die "Unsupported package family: $family" ;;
  esac
  if (( dry_run )); then printf '+ '; printf '%q ' "${root_command[@]}" "${command[@]}" "${packages[@]}"; printf '\n';
  else "${root_command[@]}" "${command[@]}" "${packages[@]}"; fi
  if (( install_flatpaks )); then
    require flatpak
    mapfile -t packages < <(jq -r '.flatpaks[]' "$ROOT/manifests/packages.json")
    if (( dry_run )); then printf '+ flatpak install --user flathub '; printf '%q ' "${packages[@]}"; printf '\n';
    else flatpak install --user flathub "${packages[@]}"; fi
  fi
}

check_repo() {
  local failed=0
  require jq
  require rsync
  jq empty "$ROOT/manifests/packages.json" "$ROOT/manifests/projects.json" "$ROOT/manifests/third-party.json" || failed=1
  jq -e '.groups | all(.[]; has("fedora") and has("arch") and has("debian") and has("opensuse"))' "$ROOT/manifests/packages.json" >/dev/null || { printf 'A package group lacks a target OS mapping.\n' >&2; failed=1; }
  jq -e 'all(.projects[]; (.id | length > 0) and (.repository | type == "string") and (.localPath | startswith("/") | not))' "$ROOT/manifests/projects.json" >/dev/null || { printf 'Invalid portable project metadata.\n' >&2; failed=1; }
  awk -F '\t' 'NR > 1 && NF != 5 {print "invalid files.tsv line " NR; bad=1} END {exit bad}' "$MANIFEST" || failed=1
  if grep -RInE --exclude-dir=.git --exclude='dotfiles' --exclude='projects.tsv' --exclude='inventory.md' 'BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY|CIDER_API_TOKEN=.{8,}|(api[_-]?key|token|password)[=:][[:space:]]*[A-Za-z0-9_-]{16,}' "$ROOT"; then
    printf 'Potential secret found.\n' >&2; failed=1
  fi
  if grep -RIl --exclude-dir=.git --exclude='dotfiles' '/home/puzll' "$ROOT/payload" "$ROOT/lib" 2>/dev/null | grep -q .; then
    printf 'Unexpected hard-coded source home found in portable content.\n' >&2; failed=1
  fi
  if grep -Ein 'kwinoutputconfig|(^|/)kscreen(/|$)|plasma-org\.kde\.plasma\.desktop-appletsrc|edid(Hash|Identifier)?|connectorName|lastScreen|activityId' "$MANIFEST" >/dev/null; then
    printf 'Hardware-bound Plasma state found in the portable manifest.\n' >&2; failed=1
  fi
  while IFS= read -r script; do bash -n "$script" || failed=1; done < <(find "$ROOT/bin" "$ROOT/lib" -type f)
  (( failed == 0 )) || exit 1
  info 'Dotfiles verification: PASS'
}

case "${1:-}" in
  list) list_modules ;;
  capture) shift; capture "$@" ;;
  apply) shift; apply_portable "$@" ;;
  apply-video-wallpapers) shift; "$ROOT/lib/apply-video-wallpapers.sh" "$@" ;;
  bootstrap) shift; bootstrap "$@" ;;
  packages) show_packages ;;
  projects) jq -r '.projects[] | [.id, .repository, .status, .purpose] | @tsv' "$ROOT/manifests/projects.json" | column -s $'\t' -t ;;
  check) check_repo ;;
  -h|--help|help|'') usage ;;
  *) die "Unknown command: $1" ;;
esac
